# توکن بات را از @BotFather بگیرید و اینجا قرار دهید
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_TOKEN

# اختیاری: اگر شبکه‌ی شما به یوتیوب/تلگرام دسترسی مستقیم ندارد، پروکسی را تنظیم کنید
# مثال: HTTPS_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=

# --- پرسونا: جانکویل 🌼 ---
# آیدی عددی تلگرام صاحب بات (تو): برای یادگیری استیکر فقط از پیام‌های تو.
# از @userinfobot بگیر. اگه خالی باشه، یادگیری استیکر از همه‌ی چت‌ها انجام می‌شه.
OWNER_ID=

# شناسه‌ی فایل استیکرهای موقت (بعد از یادگیری، اینجا بذار؛ خالی = بدون استیکر).
# فرمت: file_id تلگرام، مثلاً CAACAgIAAxkBAA...
STICKER_HELLO=
STICKER_FOUND=
STICKER_SORRY=
STICKER_FLOWER=
